{
  "name": "tape",
  "productName": "Tape",
  "version": "0.10.1",
  "description": "A desktop trading client for Interactive Brokers (TWS / IB Gateway).",
  "author": "Noah Zhu",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/icons.ts",
    "dist": "pnpm build && electron-builder --config electron-builder.yml --mac --win && node scripts/clean-release.ts",
    "dist:dir": "pnpm build && electron-builder --config electron-builder.yml --dir",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.yml --mac && node scripts/clean-release.ts",
    "dist:win": "pnpm build && electron-builder --config electron-builder.yml --win && node scripts/clean-release.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  }
}
